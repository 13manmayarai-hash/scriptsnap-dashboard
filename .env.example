# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Razorpay Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Separate from RAZORPAY_KEY_SECRET above — this is the Webhook Secret set
# when creating the webhook in the Razorpay Dashboard (Settings > Webhooks),
# used only to verify incoming webhook signatures.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Application
NEXT_PUBLIC_APP_URL=https://scriptsnap-dashboard-xxx.vercel.app
