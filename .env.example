# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# YouTube channel connect (Settings > Connect YouTube channel) — a SEPARATE
# Google Cloud OAuth client from the login-with-Google above, with its own
# redirect URI, because it requests extra sensitive scopes
# (yt-analytics.readonly, youtube.readonly) that would force every user —
# even ones who never touch this feature — through an extra consent screen
# if merged into the login flow. Redirect URI is derived at request time
# from NEXT_PUBLIC_APP_URL + /api/youtube/callback, so it isn't its own var
# — but that exact URL must be registered in Google Cloud Console.
# No NEXT_PUBLIC_ prefix: read only inside API routes, same reasoning as
# RAZORPAY_KEY_ID below (avoids Next.js build-time inlining).
GOOGLE_YOUTUBE_CLIENT_ID=your_youtube_oauth_client_id.apps.googleusercontent.com
GOOGLE_YOUTUBE_CLIENT_SECRET=your_youtube_oauth_client_secret

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Razorpay Payment Gateway
# No NEXT_PUBLIC_ prefix: only read server-side (in API routes), then
# handed to the client inside a JSON response — the prefix would make
# Next.js bake this value into the build permanently instead of reading it
# fresh at request time.
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Separate from RAZORPAY_KEY_SECRET above — this is the Webhook Secret set
# when creating the webhook in the Razorpay Dashboard (Settings > Webhooks),
# used only to verify incoming webhook signatures.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Application
NEXT_PUBLIC_APP_URL=https://scriptsnap-dashboard-xxx.vercel.app

# Sentry error tracking (Settings > Projects > scriptsnap-dashboard >
# Client Keys (DSN) in the Sentry dashboard). A DSN is meant to be public
# — it identifies where to send events, it doesn't grant read access — so
# unlike the API secrets above, it's fine (and required) to ship it to the
# browser bundle under NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oxxx.ingest.de.sentry.io/xxx
# Optional: only needed for source-map upload at build time (Sentry
# dashboard > Settings > Auth Tokens). Omit it and the build still
# succeeds — it just skips uploading sourcemaps, so stack traces in
# Sentry show minified code instead of your original source.
SENTRY_AUTH_TOKEN=
